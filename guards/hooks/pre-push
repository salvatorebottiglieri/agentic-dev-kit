#!/bin/sh
# pre-push — the DesignDoc gate (plus the model, fixtures and kit-export gates).
#
# Runs `guards/check_design.py --gate` over every document in docs/design/
# (signatures + coherence + exits + frontier; NOT the design's state, which
# expires once the code exists). A repo without docs/design/ has nothing to
# check. Installed by the same core.hooksPath as the pre-commit gate
# (`python3 guards/gate.py install <repo>`).
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
tool="$(dirname "$0")/../check_design.py"
status=0
for f in "$root"/docs/design/*.md "$root"/docs/design/*.json; do
  [ -e "$f" ] || continue
  echo "check-design: ${f#"$root"/}"
  python3 "$tool" "$f" "$root" --gate || status=1
done

# D-051 — the feature-model gate: shape + drift of the mechanical skeleton.
models_dir="$root/docs/models"
if [ -d "$models_dir" ]; then
  echo "check-model: docs/models/"
  python3 "$(dirname "$0")/../check_model.py" --root "$root" --gate --strict || status=1
fi

# B-022/D-044 — the default external-fixtures manifest, when the repo has one.
manifest="$root/tests/fixtures/PROVENANCE.md"
if [ -e "$manifest" ]; then
  echo "check-fixtures: tests/fixtures/PROVENANCE.md"
  python3 "$(dirname "$0")/../check_fixtures.py" "$manifest" "$root" || status=1
fi
# #73 — the fast kit-export tests (measured 2026-11-26: 22 tests in about 1 s, 2 s wall), when the repo has them. The tests that generate the whole kit are opt-in (KIT_RELEASE=1, run at release: KIT-EXPORT.md).
kit_tests="$root/tests/test_kit_export.py"
if [ -e "$kit_tests" ]; then
  echo "kit-export: tests/test_kit_export.py"
  (cd "$root" && python3 -m pytest -q "$kit_tests") || status=1
fi
exit "$status"
