#!/bin/sh
# pre-commit — chain of pre-commit checks for the workflow repo.
#
# Order matters: rationale-required (B-025 voce 14, structure) first,
# so a rule change without RATIONALE.md is blocked before any other
# gate runs. Then the evidence gate (D-022, script).
#
# Both checks are stdlib-Python. `pre-commit-rationale` and
# `../gate.py` exit 0 on pass, 2 on blocked (distinguishable from a
# script error). The chain stops at the first non-zero exit.

hook_dir="$(cd "$(dirname "$0")" && pwd)"
kit_dir="$(cd "$hook_dir/.." && pwd)"

# 1. Rationale-required (B-025 voce 14, STRUCTURE)
python3 "$hook_dir/pre-commit-rationale" "$@" \
  && exec python3 "$kit_dir/gate.py" pre-commit "$@"

